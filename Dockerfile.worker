FROM denoland/deno:2.9.7@sha256:fa335acdf6b72106eda2cb6a8cb5f4187e7630e357467489db4b2e7352d5e432 AS deno
FROM python:3.13.16-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=deno /usr/bin/deno /usr/local/bin/deno
WORKDIR /app
COPY requirements-worker.txt .
RUN python -m pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements-worker.txt && useradd --uid 10001 --create-home worker
COPY worker ./worker
COPY tests/worker_test.py ./tests/worker_test.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DENO_DIR=/tmp/deno HOME=/tmp
USER 10001:10001
ENTRYPOINT ["python", "-m", "worker"]
